#include <winver.h>

// ReShade reads the add-on's name and version out of this block and shows them
// in its overlay. It has to stay in step with BRIDGE_VERSION in the .cpp, which
// is what the log prints.
VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,5,0
PRODUCTVERSION 1,0,5,0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Lets a D3D12-only DLSS 5 Neural Rendering add-on run in an OpenGL game"
            VALUE "FileVersion",     "1.0.5"
            VALUE "InternalName",    "dlss5-opengl-bridge"
            VALUE "OriginalFilename","dlss5-opengl-bridge.addon64"
            VALUE "ProductName",     "DLSS 5 OpenGL Bridge"
            VALUE "ProductVersion",  "1.0.5"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
